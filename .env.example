# This file documents the intended deployment contract only. Never place real
# credentials here, and never commit a populated .env file.

# Data mode: frozen-safe | live
GWASMIND_MODE=frozen-safe

# Frozen Open Targets snapshot. The launcher passes these values explicitly;
# the application never treats this file as a secret store.
GWASMIND_OT_DATA_ROOT=/data/opentargets
GWASMIND_OT_RELEASE=25.09
GWASMIND_SNAPSHOT_MANIFEST=/data/opentargets/gwasmind_snapshot_manifest.json

# Generated artifacts and append-only audit logs.
GWASMIND_ARTIFACT_DIR=/work/artifacts
GWASMIND_RUN_DIR=/work/runs

# LLM configuration. Prefer a local OpenAI-compatible endpoint for a genuinely
# offline run. The web launcher enables an environment-backed model only when
# the key-variable name, base URL, and model ID are all explicit.
GWASMIND_MODEL_PROVIDER=local-openai-compatible
GWASMIND_MODEL_API_KEY_ENV=GWASMIND_LLM_API_KEY
GWASMIND_MODEL_ID=
GWASMIND_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# Some no-auth local OpenAI-compatible servers still require the SDK to receive
# a non-secret placeholder value, such as "local-no-auth".
GWASMIND_LLM_API_KEY=

# Optional remote provider credentials. Populate only in the process
# environment or a secret manager; never store them in browser localStorage.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
